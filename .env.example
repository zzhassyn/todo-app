POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_TIMEOUT=5s

HTTP_ADDR=:8080
HTTP_ALLOWED_ORIGIN=http://localhost:5173

# AUTH_JWT_SECRET is required and has no default — generate a long random
# value, e.g. `openssl rand -base64 48`.
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL=168h
AUTH_COOKIE_NAME=todoapp_token
# Set to true when serving over HTTPS in production.
AUTH_COOKIE_SECURE=false
